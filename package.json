{
  "name": "electrobun-elysia-demo",
  "type": "module",
  "scripts": {
    "predev": "bun --eval \"import { mkdirSync } from 'node:fs'; mkdirSync('.data', { recursive: true })\"",
    "dev": "electrobun dev --watch",
    "start": "electrobun dev",
    "build": "electrobun build",
    "build:stable": "electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "db:generate": "SQLITE_DB_URL=./.data/db.sqlite3 bunx drizzle-kit generate",
    "db:backfill-parent-name": "SQLITE_DB_URL=./.data/db.sqlite3 bun scripts/backfill-parent-name.ts",
    "db:backfill-parent-name:user-data": "bun scripts/backfill-parent-name.ts -- --user-data"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/server-timing": "^1.4.1",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@lincy/utils": "^0.7.3",
    "convict": "^6.2.5",
    "dayjs": "^1.11.21",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "electrobun": "1.18.4-beta.3",
    "elysia": "^1.4.28",
    "js-yaml": "^4.2.0",
    "lru-cache": "^11.5.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "toml": "^4.1.1",
    "twig": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lincy/eslint-config": "^7.2.0",
    "@types/bun": "^1.3.14",
    "@types/convict": "^6.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/three": "^0.184.1",
    "@types/twig": "^1.12.17",
    "bun-types": "1.3.11",
    "jiti": "^2.7.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
